# ═══════════════════════════════════════════════════════════
# Fraud Graph Explorer — Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════

# ─── Django Core ───

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts (required when DEBUG=False)
#ALLOWED_HOSTS=fraud-graph-explorer.mydomain.it

# ─── Database ───
# Choose the backend by setting DB_ENGINE:
#
#   postgresql  → PostgreSQL (recommended for production)
#   mysql       → MySQL or MariaDB
#   (unset)     → SQLite (default, for local development)
#
# When using postgresql or mysql, uncomment ALL DB_* lines below.
# When using SQLite, leave them commented — Django uses db.sqlite3 automatically.

# PostgreSQL:
#DB_ENGINE=postgresql
#DB_NAME=fraud_graph
#DB_USER=fraud_user
#DB_PASSWORD=your_password_here
#DB_HOST=localhost
#DB_PORT=5432

# MySQL / MariaDB:
#DB_ENGINE=mysql
#DB_NAME=fraud_graph
#DB_USER=fraud_user
#DB_PASSWORD=your_password_here
#DB_HOST=localhost
#DB_PORT=3306

# ─── django-axes (brute-force login protection) ───
# Enabled by default when DEBUG=False. Override here if needed.
#AXES_ENABLED=True

# Number of reverse proxies in front of Django.
# Set to 1 when behind Nginx, 0 for direct access (development).
#IPWARE_PROXY_COUNT=1